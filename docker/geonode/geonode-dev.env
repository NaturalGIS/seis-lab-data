# Environment for the GeoNode services of the dev docker compose stack - do not use this in production!
#
# This is a trimmed down version of the upstream GeoNode v5.1.1 `.env.sample` file:
#
# https://github.com/GeoNode/geonode/blob/5.1.1/.env.sample
#
# Modifications done:
# - removed most of the settings which are already set with the same default value by GeoNode itself
# - services are reachable via traefik at http://geonode.localhost:8888 (no HTTPS)
# - the GeoNode DB lives in the `geonode-db` service, as `db` is already used by seis-lab-data
# - celery uses the stack's existing redis service (`message-broker`), with dedicated DB indexes
# - lowered GeoServer's JVM memory settings

DOCKER_ENV=production
C_FORCE_ROOT=1
FORCE_REINIT=false
INVOKE_LOG_STDOUT=true
DJANGO_SETTINGS_MODULE=geonode.settings
GEONODE_INSTANCE_NAME=geonode
DEBUG=True
SECRET_KEY='geonode-dev-secret-key'

# #################
# backend
# #################
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
GEONODE_DATABASE=geonode
GEONODE_DATABASE_USER=geonode
GEONODE_DATABASE_PASSWORD=geonode
GEONODE_GEODATABASE=geonode_data
GEONODE_GEODATABASE_USER=geonode_data
GEONODE_GEODATABASE_PASSWORD=geonode_data
GEONODE_DATABASE_SCHEMA=public
GEONODE_GEODATABASE_SCHEMA=public
DATABASE_HOST=geonode-db
DATABASE_PORT=5432
DATABASE_URL=postgis://geonode:geonode@geonode-db:5432/geonode
GEODATABASE_URL=postgis://geonode_data:geonode_data@geonode-db:5432/geonode_data
GEONODE_DB_CONN_MAX_AGE=0
GEONODE_DB_CONN_TOUT=5
DEFAULT_BACKEND_DATASTORE=datastore
POSTGRESQL_MAX_CONNECTIONS=200
BROKER_URL=redis://message-broker:6379/2
CELERY_RESULT_BACKEND=redis://message-broker:6379/3
CELERY_BEAT_SCHEDULER=celery.beat:PersistentScheduler
ASYNC_SIGNALS=True
SITEURL=http://geonode.localhost:8888/
ALLOWED_HOSTS="['django', 'geonode', 'geonode.localhost']"
TIME_ENABLED=True
MOSAIC_ENABLED=False

# #################
# nginx
# #################
GEONODE_LB_HOST_IP=django
GEONODE_LB_PORT=8000
NGINX_BASE_URL=http://geonode.localhost:8888
# nginx only answers requests whose Host header matches HTTP_HOST (or 127.0.0.1)
HTTP_HOST=geonode.localhost
# leave HTTPS_HOST empty in order to only use HTTP
HTTPS_HOST=
# this is the port published by traefik - nginx itself still listens on port 80
HTTP_PORT=8888
HTTPS_PORT=443
LETSENCRYPT_MODE=disabled
RESOLVER=127.0.0.11

# #################
# geoserver
# #################
GEOSERVER_LB_HOST_IP=geoserver
GEOSERVER_LB_PORT=8080
GEOSERVER_WEB_UI_LOCATION=http://geonode.localhost:8888/geoserver/
GEOSERVER_PUBLIC_LOCATION=http://geonode.localhost:8888/geoserver/
GEOSERVER_LOCATION=http://geoserver:8080/geoserver/
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver
OGC_REQUEST_TIMEOUT=30
OGC_REQUEST_MAX_RETRIES=1
OGC_REQUEST_BACKOFF_FACTOR=0.3
OGC_REQUEST_POOL_MAXSIZE=10
OGC_REQUEST_POOL_CONNECTIONS=10
ENABLE_JSONP=true
outFormat=text/javascript
GEOSERVER_JAVA_OPTS=-Djava.awt.headless=true -Xms512m -Xmx2G -Dgwc.context.suffix=gwc -XX:+UnlockDiagnosticVMOptions -XX:+LogVMOutput -XX:LogFile=/var/log/jvm.log -XX:PerfDataSamplingInterval=500 -XX:SoftRefLRUPolicyMSPerMB=36000 -XX:-UseGCOverheadLimit -XX:ParallelGCThreads=2 -Dfile.encoding=UTF8 -Djavax.servlet.request.encoding=UTF-8 -Djavax.servlet.response.encoding=UTF-8 -Duser.timezone=GMT -Dorg.geotools.shapefile.datetime=false -DGS-SHAPEFILE-CHARSET=UTF-8 -DGEOSERVER_CSRF_DISABLED=true -DPRINT_BASE_URL=http://geonode.localhost:8888/geoserver/pdf -DALLOW_ENV_PARAMETRIZATION=true -Xbootclasspath/a:/usr/local/tomcat/webapps/geoserver/WEB-INF/lib/marlin-0.9.3-Unsafe.jar -Dsun.java2d.renderer=org.marlin.pisces.MarlinRenderingEngine
GEOSERVER_CORS_ENABLED=True
GEOSERVER_CORS_ALLOWED_ORIGINS=*
GEOSERVER_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,HEAD,OPTIONS
GEOSERVER_CORS_ALLOWED_HEADERS=*

# #################
# Security
# #################
# ADMIN_PASSWORD is only applied on the first boot (or when FORCE_REINIT=true)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@email.com
EMAIL_ENABLE=False
DEFAULT_FROM_EMAIL='GeoNode dev <no-reply@geonode.localhost>'
LOCKDOWN_GEONODE=False
X_FRAME_OPTIONS="SAMEORIGIN"
# the cached session backends always use memcached, which is not part of the dev stack
SESSION_ENGINE=django.contrib.sessions.backends.db
SESSION_EXPIRED_CONTROL_ENABLED=True
DEFAULT_ANONYMOUS_PERMISSIONS=download
DEFAULT_REGISTERED_MEMBERS_PERMISSIONS=download
CORS_ALLOW_ALL_ORIGINS=True
ACCOUNT_OPEN_SIGNUP=False
ACCOUNT_APPROVAL_REQUIRED=False
ACCOUNT_CONFIRM_EMAIL_ON_GET=False
ACCOUNT_EMAIL_VERIFICATION=none
AUTO_ASSIGN_REGISTERED_MEMBERS_TO_REGISTERED_MEMBERS_GROUP_NAME=True
AUTO_ASSIGN_REGISTERED_MEMBERS_TO_CONTRIBUTORS=True
# OAuth2 application used by GeoServer to authenticate against GeoNode
OAUTH2_API_KEY=
OAUTH2_CLIENT_ID=geonode-dev-geoserver-client-id
OAUTH2_CLIENT_SECRET=geonode-dev-geoserver-client-secret
API_LOCKDOWN=False

# #################
# Misc
# #################
STATIC_ROOT=/mnt/volumes/statics/static/
MEDIA_ROOT=/mnt/volumes/statics/uploaded/
ASSETS_ROOT=/mnt/volumes/statics/assets/
CACHE_BUSTING_STATIC_ENABLED=False
MEMCACHED_ENABLED=False
MAX_DOCUMENT_SIZE=200
CLIENT_RESULTS_LIMIT=5
API_LIMIT_PER_PAGE=1000
GEONODE_CLIENT_LAYER_PREVIEW_LIBRARY=mapstore
MODIFY_TOPICCATEGORY=True
AVATAR_GRAVATAR_SSL=True
EXIF_ENABLED=True
CREATE_LAYER=True
FAVORITE_ENABLED=True
RESOURCE_PUBLISHING=False
ADMIN_MODERATE_UPLOADS=False
HARVESTING_MONITOR_ENABLED=True
HARVESTING_MONITOR_DELAY=60
DEFAULT_MAX_PARALLEL_UPLOADS_PER_USER=5
XLSX_UPLOAD_ENABLED=False
# keep celery light in dev
CELERY__AUTOSCALE_VALUES="2,1"
CELERY__WORKER_CONCURRENCY="2"
CELERY__HARVESTER_AUTOSCALE_VALUES="2,1"
CELERY__HARVESTER_CONCURRENCY="1"
CELERY__LOG_LEVEL="INFO"
