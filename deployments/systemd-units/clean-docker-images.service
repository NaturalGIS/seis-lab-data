[Unit]
Description="Clean up docker images"
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker image prune --all --force --filter "until=72h"
ExecStart=/usr/bin/docker builder prune --all --force --filter "until=72h"
ExecStart=/usr/bin/docker container prune --force --filter "until=72h"
Nice=10
IOSchedulingClass=idle
User=naturalgis
